\_eprint: https://doi.org/10.1080/13504851.2019.1696930},
	keywords = {C26, C21, difference in difference, Fuzzy regression discontinuity, imperfect compliance, public policy evaluation},
	pages = {1552--1555},
	file = {Millan 2019 Fuzzy Diff-in-discont.pdf:C\:\\Users\\zadel\\Zotero\\storage\\54TK9J2T\\Millan 2019 Fuzzy Diff-in-discont.pdf:application/pdf},

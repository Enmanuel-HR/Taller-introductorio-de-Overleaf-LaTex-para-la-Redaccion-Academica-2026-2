	issn = {1350-4851},
	url = {https://doi.org/10.1080/13504851.2019.1696930},
	doi = {10.1080/13504851.2019.1696930},
	abstract = {This paper discusses the conditions needed to estimate the local average treatment effect (LATE) of a policy using the ‘difference-in-discontinuities’ method while considering imperfect compliance. I show that simple and plausible assumptions about the participation and effects of the confounding existing policies allow the identification of the causal effect of a new policy. Identification is feasible even when information about the participation in other confounding policies is not available.},
	number = {19},
	urldate = {2024-10-02},
	journal = {Applied Economics Letters},

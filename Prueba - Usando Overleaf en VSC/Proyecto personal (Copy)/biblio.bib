@article{larsen_fuzzy_2023,
	title = {Fuzzy difference-in-discontinuities when the confounding variation is sharp: evidence from grade retention policies},
	volume = {30},
	issn = {1350-4851},
	shorttitle = {Fuzzy difference-in-discontinuities when the confounding variation is sharp},
	url = {https://doi.org/10.1080/13504851.2022.2089339},
	doi = {10.1080/13504851.2022.2089339},
	abstract = {This letter examines a fuzzy difference-in-discontinuity design where the primary policy of interest has imperfect compliance but confounding variation has perfect compliance. After proposing the estimator, we examine an application in education policy where test score cut-offs are used to determine grade assignment with imperfect compliance but performance labels with perfect compliance. We find that students who are not retained in 8th grade are more likely to graduate high school and attend college. Furthermore, after accounting for the effect of confounding performance labels, estimates are even more positive. Notably, we also find that our fuzzy difference-in-discontinuity estimates are quite noisy, suggesting that applications of the estimator may be limited to settings with many observations near the threshold. This estimator may be useful in education research and other settings where scores are used to both assign treatment and label individuals.},
	number = {15},
	urldate = {2024-10-02},
	journal = {Applied Economics Letters},
	author = {Larsen, Matthew F. and Valant, Jon},
	month = sep,
	year = {2023},
	note = {Publisher: Routledge
\_eprint: https://doi.org/10.1080/13504851.2022.2089339},
	keywords = {regression discontinuity, C10, C20, Difference-in-discontinuity, educational attainment, I00, I20, retention},
	pages = {2009--2013},
	file = {Full Text PDF:C\:\\Users\\zadel\\Zotero\\storage\\9C9MLFBC\\Larsen y Valant - 2023 - Fuzzy difference-in-discontinuities when the confo.pdf:application/pdf;Larsen 2023.pdf:C\:\\Users\\zadel\\Zotero\\storage\\V978PFYW\\Larsen 2023.pdf:application/pdf},
}

@article{cattaneo_regression_2022,
	title = {Regression {Discontinuity} {Designs}},
	volume = {14},
	url = {https://doi.org/10.1146/annurev-economics-051520-021409},
	doi = {10.1146/annurev-economics-051520-021409},
	abstract = {The regression discontinuity (RD) design is one of the most widely used nonexperimental methods for causal inference and program evaluation. Over the last two decades, statistical and econometric methods for RD analysis have expanded and matured, and there is now a large number of methodological results for RD identification, estimation, inference, and validation. We offer a curated review of this methodological literature organized around the two most popular frameworks for the analysis and interpretation of RD designs: the continuity framework and the local randomization framework. For each framework, we discuss three main topics: (a) designs and parameters, focusing on different types of RD settings and treatment effects of interest; (b) estimation and inference, presenting the most popular methods based on local polynomial regression and methods for the analysis of experiments, as well as refinements, extensions, and alternatives; and (c) validation and falsification, summarizing an array of mostly empirical approaches to support the validity of RD designs in practice.},
	number = {1},
	urldate = {2023-08-06},
	journal = {Annual Review of Economics},
	author = {Cattaneo, Matias D. and Titiunik, Rocío},
	year = {2022},
	note = {\_eprint: https://doi.org/10.1146/annurev-economics-051520-021409},
	keywords = {regression discontinuity, causal inference, JEL C10, JEL C18, JEL C21, nonexperimental methods, program evaluation, treatment effects},
	pages = {821--851},
	file = {Cattaneo y Titiunik - 2022 - Regression Discontinuity Designs.pdf:C\:\\Users\\zadel\\Zotero\\storage\\5PM6HY6G\\Cattaneo y Titiunik - 2022 - Regression Discontinuity Designs.pdf:application/pdf},
}


@article{mendez_efectos_2022,
	title = {Los {Efectos} del {Sexo} y del {Autoritarismo} en la {Legitimación} de los {Abusos} {Policiales}},
	volume = {32},
	copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0/deed.es\_ES},
	issn = {1133-0740},
	url = {https://journals.copmadrid.org/apj/art/apj2021a18},
	doi = {10.5093/apj2021a18},
	abstract = {This research analyzes whether authoritarianism increases support for police abuse and if the effect is greater in men than in women. In addition, it explores whether fusion with the police, a predictor of extreme behavior, can mediate that effect. An exploratory correlational study was carried out with 149 Spaniards, in which two levels of police force were established, reasonable and excessive. The results showed a direct association between authoritarianism and support for the use of police force and an indirect association through fusion. Furthermore, the effects of authoritarianism on support for the use of police force were found to be stronger in men than in women, but only when the force used was excessive. These results suggest that ideological factors and psychosocial variables such as fusion and gender roles play a role in the legitimation of police excesses.},
	language = {es},
	number = {1},
	urldate = {2025-08-14},
	journal = {Anuario de Psicologia Juridica},
	author = {Méndez, David and Lois, David and Vázquez, Alexandra},
	month = jan,
	year = {2022},
	note = {Company: Colegio Oficial de Psicologos de Madrid (copmadrid)
Distributor: Colegio Oficial de Psicologos de Madrid (copmadrid)
Institution: Colegio Oficial de Psicologos de Madrid (copmadrid)
Label: Colegio Oficial de Psicologos de Madrid (copmadrid)
Publisher: Colegio Oficial de Psicologos de Madrid
Section: research-article},
	pages = {71--77},
	file = {Full Text PDF:C\:\\Users\\enman\\Zotero\\storage\\KUC5MVF6\\Méndez et al. - 2022 - Los Efectos del Sexo y del Autoritarismo en la Legitimación de los Abusos Policiales.pdf:application/pdf},
